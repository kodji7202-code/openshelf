---
import Base from "../../layouts/Base.astro";
import { href } from "../../lib/urls";
import { categoryName, languageName, repoUrl, templates } from "../../lib/templates";

export function getStaticPaths() {
  return templates.map((template) => ({ params: { slug: template.slug }, props: { template } }));
}

const { template } = Astro.props;
const delisted = template.status === "delisted";
const votes = template.votes === null ? "indisponibil" : String(template.votes);
const toolNames: Record<string, string> = {
  browser: "Browser",
  "computer-use": "Computer Use",
  github: "GitHub",
  "web-search": "Căutare web",
  files: "Fișiere",
  shell: "Terminal",
};

const title = `${template.name} — OpenShelf`;
const description = template.tagline;
---

<Base {title} {description} noindex={delisted}>
  <a class="back" href={href()}>← Toate șabloanele</a>

  {
    delisted && (
      <div class="banner">
        Acest șablon a fost retras din catalog. Poate fi readus de autor, iar linkul oficial poate să nu mai existe.
      </div>
    )
  }

  <h1 class="title">{template.name}</h1>
  <p class="lede">{template.tagline}</p>

  <div class="meta" style="margin-top:0.9rem">
    <span class="tag">{categoryName(template.category)}</span>
    <span class="pill">{languageName(template.language)}</span>
    {template.tags.map((tag) => <span class="pill">{tag}</span>)}
  </div>

  <div class="columns">
    <div>
      <section class="panel">
        <h2>Despre</h2>
        <p>{template.description}</p>
      </section>

      <section class="panel">
        <h2>Ce conține agentul</h2>
        <dl class="facts">
          <dt>Titlu</dt>
          <dd>{template.agent.title || template.name}</dd>
          <dt>Skill-uri</dt>
          <dd>{template.agent.skills.length === 0 ? "niciunul" : template.agent.skills.join(", ")}</dd>
          <dt>Rutine</dt>
          <dd>{template.agent.routines ? "da, agentul are rutine programate" : "nu"}</dd>
        </dl>
        <h2 style="margin-top:1.2rem">Instrucțiunile agentului</h2>
        <pre class="instructions">{template.agent.description}</pre>
        <p class="note">
          Textul de mai sus este exact ce a publicat autorul în șablonul oficial. Este afișat ca text, nu interpretat.
        </p>
      </section>

      {
        template.requires && (
          <section class="panel">
            <h2>Cerințe</h2>
            <p>
              {template.requires.tools.length === 0
                ? "Nimic în afara OpenBot."
                : template.requires.tools.map((tool) => toolNames[tool] ?? tool).join(", ")}
            </p>
            {template.requires.notes && <p class="note">{template.requires.notes}</p>}
          </section>
        )
      }
    </div>

    <aside>
      <section class="panel">
        <h2>Instalare</h2>
        <a class="btn" href={template.officialLink} target="_blank" rel="noopener noreferrer">
          Deschide șablonul oficial
        </a>
        <p class="note">
          Linkul deschide previzualizarea în OpenBot. Instalarea este un click pe <strong>Install</strong> acolo; OpenShelf
          nu poate instala nimic în locul tău.
        </p>
        <div class="deeplink">
          <label class="skip" for="deep">Link direct pentru aplicația desktop</label>
          <input id="deep" type="text" readonly value={template.deepLink} data-deep-link />
          <button class="btn quiet" type="button" data-copy>Copiază</button>
        </div>
        <p class="note" data-copy-note hidden>Copiat.</p>
      </section>

      <section class="panel">
        <h2>Detalii</h2>
        <dl class="facts">
          <dt>Autor</dt>
          <dd>
            <a href={`https://github.com/${template.creator.github}`} rel="noopener">{template.creator.name}</a>
          </dd>
          <dt>Voturi</dt>
          <dd>{votes}</dd>
          <dt>Publicat</dt>
          <dd><time datetime={template.submittedAt}>{template.submittedAt}</time></dd>
          <dt>Actualizat</dt>
          <dd><time datetime={template.updatedAt}>{template.updatedAt}</time></dd>
          <dt>Sursă</dt>
          <dd><a href={repoUrl(`/blob/main/templates/${template.slug}.json`)} rel="noopener">fișierul din catalog</a></dd>
        </dl>
      </section>

      <section class="panel">
        <h2>Ceva nu e în regulă?</h2>
        <p class="note" style="margin-top:0">
          Dacă linkul nu merge, agentul face altceva decât scrie aici, sau conținutul încalcă drepturi,{" "}
          <a href={repoUrl(`/issues/new?title=${encodeURIComponent(`Raport: ${template.name}`)}`)} rel="noopener">
            deschide un raport
          </a>
          . Moderatorii pot retrage șablonul din catalog.
        </p>
      </section>
    </aside>
  </div>
</Base>

<script>
  const button = document.querySelector<HTMLButtonElement>("[data-copy]");
  const field = document.querySelector<HTMLInputElement>("[data-deep-link]");
  const note = document.querySelector<HTMLElement>("[data-copy-note]");

  button?.addEventListener("click", async () => {
    if (!field) return;
    try {
      await navigator.clipboard.writeText(field.value);
      if (note) note.hidden = false;
    } catch {
      field.select();
    }
  });
</script>
