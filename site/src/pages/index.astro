---
import Base from "../layouts/Base.astro";
import Card from "../components/Card.astro";
import { categoriesInUse, categoryName, languagesInUse, languageName, published } from "../lib/templates";

const base = import.meta.env.BASE_URL;
const categories = categoriesInUse();
const languages = languagesInUse();
const total = published.length;

const title = "OpenShelf — șabloane de agenți pentru OpenBot";
const description =
  "Director comunitar de șabloane de agenți pentru OpenBot (openbot.run). Fiecare card duce la șablonul oficial publicat de autorul lui; instalarea se face în OpenBot.";
---

<Base {title} {description}>
  <section class="hero">
    <h1>Șabloane de agenți, alese de oameni care le-au folosit</h1>
    <p>
      Un director comunitar pentru agenții publicați pe OpenBot. Fiecare card duce la șablonul oficial al autorului:
      OpenShelf nu găzduiește agenți și nu instalează nimic în locul tău — deschide previzualizarea din OpenBot, iar
      instalarea rămâne un click acolo.
    </p>
    <p class="count" data-count>
      {total === 0 ? "Niciun șablon publicat încă." : `${total} ${total === 1 ? "șablon publicat" : "șabloane publicate"}.`}
    </p>
  </section>

  {
    total > 0 && (
      <section class="toolbar" aria-label="Caută și filtrează" data-filter-root>
        <label for="q" class="skip">
          Caută șabloane
        </label>
        <input id="q" type="search" placeholder="Caută după nume, autor, tag…" autocomplete="off" />
        <label for="lang" class="skip">
          Limba instrucțiunilor
        </label>
        <select id="lang">
          <option value="all">Toate limbile</option>
          {languages.map((code) => (
            <option value={code}>{languageName(code)}</option>
          ))}
        </select>
        <div class="chips" role="group" aria-label="Categorie">
          <button type="button" class="chip" data-category="all" aria-pressed="true">
            Toate
          </button>
          {categories.map((code) => (
            <button type="button" class="chip" data-category={code} aria-pressed="false">
              {categoryName(code)}
            </button>
          ))}
        </div>
      </section>
    )
  }

  <noscript>
    <p class="noscript">
      Căutarea și filtrele au nevoie de JavaScript. Fără el, toate șabloanele publicate sunt listate mai jos.
    </p>
  </noscript>

  {
    total === 0 ? (
      <div class="empty">
        <strong>Raftul e încă gol.</strong>
        Catalogul pornește fără șabloane. Primul loc poate fi al tău:{" "}
        <a href="https://github.com/kodji7202-code/openshelf/issues/new?template=submit-template.yml">
          trimite un șablon
        </a>{" "}
        după ce îl publici în OpenBot.
      </div>
    ) : (
      <ul class="grid" id="grid">
        {published.map((template, index) => (
          <Card template={template} index={index} />
        ))}
      </ul>
    )
  }

  <div class="empty hidden" data-empty>
    <strong>Nimic pe raftul ăsta.</strong>
    Niciun șablon nu se potrivește cu căutarea și filtrele alese. <button type="button" class="chip" data-reset>Golește filtrele</button>
  </div>

  <p class="note">
    Un card nu este o recomandare. Deschide linkul oficial, citește instrucțiunile agentului și decide dacă îl instalezi:
    șabloanele sunt scrise de autori independenți, iar OpenShelf nu le verifică execuția.
  </p>
</Base>

<script>
  const root = document.querySelector<HTMLElement>("[data-filter-root]");
  const cards = Array.from(document.querySelectorAll<HTMLElement>(".card"));
  const grid = document.getElementById("grid");
  const emptyState = document.querySelector<HTMLElement>("[data-empty]");
  const count = document.querySelector<HTMLElement>("[data-count]");
  const total = cards.length;

  if (root && grid && emptyState && count) {
    const input = root.querySelector<HTMLInputElement>("input[type=search]");
    const select = root.querySelector<HTMLSelectElement>("select");
    const chips = Array.from(root.querySelectorAll<HTMLButtonElement>(".chip"));
    const allLabel = count.textContent ?? "";
    let category = "all";

    const apply = (updateUrl = true) => {
      const query = (input?.value ?? "").trim().toLowerCase();
      const language = select?.value ?? "all";
      let shown = 0;
      for (const card of cards) {
        const matchesQuery = query === "" || (card.dataset.haystack ?? "").includes(query);
        const matchesCategory = category === "all" || card.dataset.category === category;
        const matchesLanguage = language === "all" || card.dataset.language === language;
        const visible = matchesQuery && matchesCategory && matchesLanguage;
        card.classList.toggle("hidden", !visible);
        if (visible) shown += 1;
      }
      emptyState.classList.toggle("hidden", shown > 0);
      count.textContent = shown === total ? allLabel : `${shown} din ${total} șabloane.`;
      if (updateUrl) {
        const params = new URLSearchParams();
        if (query) params.set("q", query);
        if (category !== "all") params.set("cat", category);
        if (language !== "all") params.set("lang", language);
        const search = params.toString();
        history.replaceState(null, "", search ? `?${search}` : location.pathname);
      }
    };

    for (const chip of chips) {
      chip.addEventListener("click", () => {
        category = chip.dataset.category ?? "all";
        for (const other of chips) other.setAttribute("aria-pressed", String(other === chip));
        apply();
      });
    }
    input?.addEventListener("input", () => apply());
    select?.addEventListener("change", () => apply());
    root.querySelector("[data-reset]")?.addEventListener("click", () => {
      if (input) input.value = "";
      if (select) select.value = "all";
      category = "all";
      for (const chip of chips) chip.setAttribute("aria-pressed", String(chip.dataset.category === "all"));
      apply();
      input?.focus();
    });

    const initial = new URLSearchParams(location.search);
    if (input) input.value = initial.get("q") ?? "";
    const initialCategory = initial.get("cat");
    if (initialCategory && chips.some((chip) => chip.dataset.category === initialCategory)) {
      category = initialCategory;
      for (const chip of chips) chip.setAttribute("aria-pressed", String(chip.dataset.category === category));
    }
    const initialLanguage = initial.get("lang");
    if (select && initialLanguage && Array.from(select.options).some((option) => option.value === initialLanguage))
      select.value = initialLanguage;
    apply(false);
  }
</script>
