---
import Base from "../layouts/Base.astro";
import Card from "../components/Card.astro";
import { href } from "../lib/urls";
import { categoriesInUse, languagesInUse, published, languageName, repoUrl } from "../lib/templates";
import { translator, type Locale } from "../i18n";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = translator(locale);
const categories = categoriesInUse();
const languages = languagesInUse();
const total = published.length;
const allLabel =
  total === 0
    ? t("count.none")
    : total === 1
      ? t("count.one")
      : t("count.many", { count: total });
const submitUrl = repoUrl("/issues/new?template=submit-template.yml");
const title = t("page.title");
const description = t("page.description");
---

<Base locale={locale} title={title} description={description}>
  <section class="hero">
    <p class="eyebrow">{t("hero.eyebrow")}</p>
    <h1>{t("hero.title")}</h1>
    <p>{t("hero.description")}</p>
    <div class="hero-actions">
      <a class="btn" href="#catalog">{t("hero.cta")}</a>
      <p class="count" data-count data-all={allLabel}>{allLabel}</p>
    </div>
  </section>

  <div id="catalog">
    {
      total > 0 && (
        <section class="toolbar" aria-label={t("toolbar.label")} data-filter-root hidden>
          <div class="search-field">
            <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8">
              <circle cx="11" cy="11" r="6.3" />
              <path d="m16 16 4.2 4.2" stroke-linecap="round" />
            </svg>
            <label for="q" class="skip">
              {t("search.label")}
            </label>
            <input id="q" type="search" placeholder={t("search.placeholder")} autocomplete="off" />
            <span class="search-hint" aria-hidden="true">Ctrl K</span>
          </div>
          <label for="lang" class="skip">
            {t("filter.language")}
          </label>
          <select id="lang">
            <option value="all">{t("filter.language.all")}</option>
            {languages.map((code) => (
              <option value={code}>{languageName(code, locale)}</option>
            ))}
          </select>
          <div class="chips" role="group" aria-label={t("filter.category")}>
            <button type="button" class="chip" data-category="all" aria-pressed="true">
              {t("filter.category.all")}
            </button>
            {categories.map((code) => (
              <button type="button" class="chip" data-category={code} aria-pressed="false">
                {t(`category.${code}` as never)}
              </button>
            ))}
          </div>
        </section>
      )
    }

    <noscript>
      <p class="noscript">{t("noscript")}</p>
    </noscript>

    {
      total === 0 ? (
        <div class="empty">
          <strong>{t("empty.catalog.title")}</strong>
          {t("empty.catalog.body")}{" "}
          <a href={submitUrl} rel="noopener">{t("empty.catalog.action")}</a>.
        </div>
      ) : (
        <ul class="grid" id="grid">
          {published.map((template) => (
            <Card template={template} locale={locale} />
          ))}
        </ul>
      )
    }

    <div class="empty hidden" data-empty>
      <strong>{t("empty.filtered.title")}</strong>
      {t("empty.filtered.body")}{" "}
      <button type="button" class="chip" data-reset>{t("filter.clear")}</button>
    </div>
  </div>

  <p class="note">{t("catalog.note")}</p>
</Base>

<script>
  const root = document.querySelector<HTMLElement>("[data-filter-root]");
  const cards = Array.from(document.querySelectorAll<HTMLElement>(".card"));
  const grid = document.getElementById("grid");
  const emptyState = document.querySelector<HTMLElement>("[data-empty]");
  const count = document.querySelector<HTMLElement>("[data-count]");
  const total = cards.length;
  const filteredTemplate = document.documentElement.lang === "es" ? "{shown} de {total} plantillas." : "{shown} of {total} templates.";

  if (root && grid && emptyState && count) {
    // The controls only exist for a browser that can use them; without this line they stay hidden.
    root.hidden = false;
    const input = root.querySelector<HTMLInputElement>("input[type=search]");
    const select = root.querySelector<HTMLSelectElement>("select");
    const chips = Array.from(root.querySelectorAll<HTMLButtonElement>(".chip"));
    const allLabel = count.dataset.all ?? "";
    let category = "all";

    const apply = (updateUrl = true) => {
      const query = (input?.value ?? "").trim().toLowerCase();
      const language = select?.value ?? "all";
      let shown = 0;
      for (const card of cards) {
        const matchesQuery = query === "" || (card.dataset.haystack ?? "").includes(query);
        const matchesCategory = category === "all" || card.dataset.category === category;
        const matchesLanguage = language === "all" || card.dataset.language === language;
        const visible = matchesQuery && matchesCategory && matchesLanguage;
        card.classList.toggle("hidden", !visible);
        if (visible) shown += 1;
      }
      const list = document.querySelector(".grid");
      list?.classList.toggle("hidden", shown === 0);
      emptyState.classList.toggle("hidden", shown > 0);
      count.textContent =
        shown === total ? allLabel : filteredTemplate.replace("{shown}", String(shown)).replace("{total}", String(total));
      if (updateUrl) {
        const params = new URLSearchParams();
        if (query) params.set("q", query);
        if (category !== "all") params.set("cat", category);
        if (language !== "all") params.set("lang", language);
        const search = params.toString();
        history.replaceState(null, "", search ? `?${search}` : location.pathname);
      }
    };

    const clear = () => {
      if (input) input.value = "";
      if (select) select.value = "all";
      category = "all";
      for (const chip of chips) chip.setAttribute("aria-pressed", String(chip.dataset.category === "all"));
      apply();
      input?.focus();
    };

    for (const chip of chips) {
      chip.addEventListener("click", () => {
        category = chip.dataset.category ?? "all";
        for (const other of chips) other.setAttribute("aria-pressed", String(other === chip));
        apply();
      });
    }
    input?.addEventListener("input", () => apply());
    select?.addEventListener("change", () => apply());
    emptyState.querySelector("[data-reset]")?.addEventListener("click", clear);

    const focusSearch = () => input?.focus();
    document.addEventListener("keydown", (event) => {
      if ((event.metaKey || event.ctrlKey) && event.key.toLowerCase() === "k") {
        event.preventDefault();
        focusSearch();
      }
    });

    const initial = new URLSearchParams(location.search);
    if (input) input.value = initial.get("q") ?? "";
    const initialCategory = initial.get("cat");
    if (initialCategory && chips.some((chip) => chip.dataset.category === initialCategory)) {
      category = initialCategory;
      for (const chip of chips) chip.setAttribute("aria-pressed", String(chip.dataset.category === category));
    }
    const initialLanguage = initial.get("lang");
    if (select && initialLanguage && Array.from(select.options).some((option) => option.value === initialLanguage))
      select.value = initialLanguage;
    apply(false);
  }
</script>
