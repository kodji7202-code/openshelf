---
import Base from "../layouts/Base.astro";
import Hex from "../components/Hex.astro";
import { href } from "../lib/urls";
import { categoryName, languageName, published, repoUrl, type Template } from "../lib/templates";
import { taglinesEs, translator, type Locale } from "../i18n";

interface Props {
  template: Template;
  locale: Locale;
}

const { template, locale } = Astro.props;
const t = translator(locale);
const delisted = template.status === "delisted";
const catalogHref = href(`${locale === "es" ? "es/" : ""}#catalog`);
const tagline = (locale === "es" ? taglinesEs[template.slug] : undefined) ?? template.tagline;
const zip = href(`downloads/${template.slug}.zip`);
const index = published.findIndex((item) => item.slug === template.slug);
const more = [1, 2, 3].map((offset) => published[(index + offset) % published.length]).filter(Boolean);
const blocks = template.agent.description.split(/\n{2,}/u);

function blockLabel(text: string): { label: string; body: string } | null {
  const match = /^(Anti-jobs|Rules):\s*([\s\S]*)$/u.exec(text);
  if (!match) return null;
  return { label: match[1], body: match[2] };
}

const title = `${template.name} — OpenShelf`;
---

<Base locale={locale} title={title} description={tagline} noindex={delisted}>
  <section class="detail-hero">
    <a class="back" href={catalogHref}>← {t("detail.back")}</a>
    <div class="detail-copy">
      <h1>{template.name}</h1>
      <p class="detail-tagline">{tagline}</p>
      {delisted && <p class="note">{t("detail.delisted")}</p>}
    </div>
    <div class="detail-actions">
      <p class="meta-line">
        {categoryName(template.category, locale)} · {languageName(template.language, locale)} ·{" "}
        {t("card.by", { name: template.creator.name })}
      </p>
      {template.officialLink ? (
        <a class="btn" href={template.officialLink} rel="noopener noreferrer" target="_blank">
          {t("card.install")}<span class="sr"> {t("a11y.newTab")}</span>
        </a>
      ) : (
        <a class="btn" href={zip} download>{t("card.download")}</a>
      )}
      {template.officialLink && (
        <p class="note">
          <a href={zip} download>{t("detail.installZip")}</a> · {t("detail.zipNote")}
        </p>
      )}
    </div>
  </section>

  <section class="detail-stage" aria-labelledby="instructions-h">
    <div class="doc" data-ui>
      <h2 id="instructions-h" class="sr">{t("detail.stageTitle")}</h2>
      {
        blocks.map((block) => {
          const labelled = blockLabel(block);
          return labelled ? (
            <>
              <h3>{labelled.label}</h3>
              <p>{labelled.body}</p>
            </>
          ) : (
            <p>{block}</p>
          );
        })
      }
    </div>
    <p class="detail-report">
      {t("detail.reportBody")}{" "}
      <a href={repoUrl(`/issues/new?title=${encodeURIComponent(`Report: ${template.name}`)}`)} rel="noopener">
        {t("detail.reportAction")}
      </a>.
    </p>
  </section>

  <section class="detail-meta">
    <div>
      <h2>{t("detail.tagsTitle")}</h2>
      <ul class="chip-list">
        {template.tags.map((tag) => <li>{tag}</li>)}
      </ul>
    </div>
    <div>
      <h2>{t("detail.skillsTitle")}</h2>
      <p>{template.agent.skills.length === 0 ? t("detail.none") : template.agent.skills.join(", ")}</p>
      <p class="note">
        <a href={repoUrl(`/blob/main/templates/${template.slug}.json`)} rel="noopener">templates/{template.slug}.json</a>
      </p>
    </div>
  </section>

  <section class="more" aria-labelledby="more-h">
    <h2 id="more-h">{t("detail.more")}</h2>
    <ul class="rows">
      {
        more.map((item) => (
          <li class="row-mini">
            <a href={href(`${locale === "es" ? "es/" : ""}t/${item.slug}/`)}>{item.name}</a>
            <p>{categoryName(item.category, locale)} · {item.officialLink ? t("card.install") : t("card.download")}</p>
          </li>
        ))
      }
    </ul>
  </section>
</Base>
