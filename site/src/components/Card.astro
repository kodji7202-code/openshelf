---
import { categoryName, languageName, type Template } from "../lib/templates";
import { href } from "../lib/urls";

interface Props {
  template: Template;
  index: number;
}

const { template } = Astro.props;
const link = href(`t/${template.slug}/`);
const haystack = [
  template.name,
  template.tagline,
  template.description,
  template.category,
  categoryName(template.category),
  template.language,
  languageName(template.language),
  template.creator.name,
  template.creator.github,
  ...template.tags,
  ...template.agent.skills,
].join(" ").toLowerCase();
---

<li
  class="card"
  data-category={template.category}
  data-language={template.language}
  data-haystack={haystack}
  data-name={template.name.toLowerCase()}
>
  <div class="meta">
    <span class="tag">{categoryName(template.category)}</span>
    <span class="pill">{languageName(template.language)}</span>
  </div>
  <h2><a href={link}>{template.name}</a></h2>
  <p>{template.tagline}</p>
  <div class="footer">
    <span class="by" title={`Creat de ${template.creator.name}`}>de {template.creator.name}</span>
    <a class="by" href={href(`t/${template.slug}/`)}>Detalii →</a>
  </div>
</li>
