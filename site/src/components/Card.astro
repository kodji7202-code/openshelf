---
import Hex from "./Hex.astro";
import { categoryName, languageName, type Template } from "../lib/templates";
import { href } from "../lib/urls";
import { taglinesEs, translator, type Locale } from "../i18n";

interface Props {
  template: Template;
  locale: Locale;
}

const { template, locale } = Astro.props;
const t = translator(locale);
const link = href(`${locale === "es" ? "es/" : ""}t/${template.slug}/`);
const tagline = (locale === "es" ? taglinesEs[template.slug] : undefined) ?? template.tagline;
const haystack = [
  template.name,
  tagline,
  template.tagline,
  template.category,
  categoryName(template.category, "en"),
  categoryName(template.category, "es"),
  template.language,
  languageName(template.language, "en"),
  ...template.tags,
].join(" ").toLowerCase();
const official = Boolean(template.officialLink);
---

<li
  class="row"
  data-cat={template.category}
  data-language={template.language}
  data-hay={haystack}
  data-category={template.category}
  data-haystack={haystack}
>
  <a class="row-name" href={link}>
    <Hex class="bullet" />
    <span>{template.name}</span>
  </a>
  <p class="row-job">{tagline}</p>
  <p class="row-fact">
    <span>{categoryName(template.category, locale)} · {template.language.toUpperCase()}</span>
    {official ? (
      <a class="act" href={template.officialLink} rel="noopener noreferrer" target="_blank">
        {t("card.install")}<span class="sr"> {t("a11y.newTab")}</span>
      </a>
    ) : (
      <a class="act" href={href(`downloads/${template.slug}.zip`)} download>{t("card.download")}</a>
    )}
  </p>
</li>
