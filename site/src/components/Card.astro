---
import { categoryName, languageName, type Template } from "../lib/templates";
import { href } from "../lib/urls";
import { taglinesEs, translator, type Locale } from "../i18n";

interface Props {
  template: Template;
  locale: Locale;
}

const { template, locale } = Astro.props;
const t = translator(locale);
const link = href(`${locale === "es" ? "es/" : ""}t/${template.slug}/`);
const tagline =
  (locale === "es" ? taglinesEs[template.slug] : undefined) ?? template.tagline;
const haystack = [
  template.name,
  tagline,
  template.tagline,
  template.description,
  template.category,
  categoryName(template.category, "en"),
  categoryName(template.category, "es"),
  template.language,
  languageName(template.language, "en"),
  languageName(template.language, "es"),
  template.creator.name,
  template.creator.github,
  ...template.tags,
  ...template.agent.skills,
].join(" ").toLowerCase();
---

<li
  class="card"
  data-category={template.category}
  data-language={template.language}
  data-haystack={haystack}
  data-name={template.name.toLowerCase()}
>
  <div class="meta">
    <span class="tag">{categoryName(template.category, locale)}</span>
    <span class="pill">{languageName(template.language, locale)}</span>
  </div>
  <h2><a href={link}>{template.name}</a></h2>
  <p>{tagline}</p>
  <div class="footer">
    <span class="by" title={t("card.by", { name: template.creator.name })}>
      {t("card.by", { name: template.creator.name })}
    </span>
    {template.officialLink ? (
      <a href={template.officialLink} target="_blank" rel="noopener noreferrer">
        {t("card.install")}
      </a>
    ) : (
      <a href={href(`downloads/${template.slug}.zip`)} download>{t("card.download")}</a>
    )}
    <a href={link}>{t("card.details")}</a>
  </div>
</li>
