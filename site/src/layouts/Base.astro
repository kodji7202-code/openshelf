---
import "../styles/global.css";
import { href, base } from "../lib/urls";
import { repoUrl } from "../lib/templates";

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
}

const { title, description, noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="ro">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical.href} />
    <link rel="icon" href={href("favicon.svg")} type="image/svg+xml" />
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="OpenShelf" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical.href} />
    <meta name="twitter:card" content="summary" />
  </head>
  <body>
    <a class="skip" href="#main">Sari la conținut</a>

    <header class="site">
      <div class="wrap">
        <a class="brand" href={base}>
          <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8">
            <path d="M3 8.5h18M5.5 8.5V19a1 1 0 0 0 1 1h11a1 1 0 0 0 1-1V8.5" stroke-linecap="round" />
            <path d="M8 8.5V5.5a1 1 0 0 1 1-1h6a1 1 0 0 1 1 1v3" stroke-linecap="round" />
            <path d="M9.5 12.5h5" stroke-linecap="round" />
          </svg>
          OpenShelf
        </a>
        <nav aria-label="Principal">
          <a href={href("about/")}>Despre</a>
          <a href={repoUrl("")} rel="noopener">GitHub</a>
          <a href={repoUrl("/issues/new?template=submit-template.yml")} rel="noopener">Trimite un șablon</a>
        </nav>
      </div>
    </header>

    <main id="main">
      <div class="wrap">
        <slot />
      </div>
    </main>

    <footer class="site">
      <div class="wrap">
        <p>
          Proiect comunitar independent. <strong>Neafiliat, neaprobat și nesponsorizat</strong> de OpenBot sau de
          Synthetify Labs sp. z o.o. „OpenBot” apare doar ca referință descriptivă la platforma pentru care există
          șabloanele.
        </p>
        <nav aria-label="Legal și contribuții">
          <a href={href("about/")}>Despre și reguli</a>
          <a href={repoUrl("/blob/main/DISCLAIMER.md")} rel="noopener">Disclaimer</a>
          <a href={repoUrl("/blob/main/README.md#licen%C8%9Be")} rel="noopener">Licențe</a>
          <a href={repoUrl("/blob/main/legal/TERMS.md")} rel="noopener">Termeni (ciornă)</a>
        </nav>
      </div>
    </footer>
  </body>
</html>
