---
import "../styles/global.css";
import Hex from "../components/Hex.astro";
import { href, base } from "../lib/urls";
import { repoUrl } from "../lib/templates";
import { translator, switchLocalePath, localePath, type Locale } from "../i18n";

interface Props {
  locale: Locale;
  title: string;
  description: string;
  noindex?: boolean;
}

const { locale, title, description, noindex = false } = Astro.props;
const t = translator(locale);
const canonical = new URL(Astro.url.pathname, Astro.site);
const switchHref = switchLocalePath(locale === "en" ? "es" : "en", Astro.url.pathname);
const home = href(localePath(locale));
const submitUrl = repoUrl("/issues/new?template=submit-template.yml");
const aboutHref = href(localePath(locale, "about/"));
---

<!doctype html>
<html lang={locale} data-locale={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical.href} />
    <link rel="alternate" hreflang="en" href={new URL(href(localePath("en", "")), Astro.site).href} />
    <link rel="alternate" hreflang="es" href={new URL(href(localePath("es", "")), Astro.site).href} />
    <link rel="alternate" hreflang="x-default" href={new URL(href(localePath("en", "")), Astro.site).href} />
    <link rel="icon" href={href("favicon.svg")} type="image/svg+xml" />
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="OpenShelf" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical.href} />
    <meta name="twitter:card" content="summary" />
    <script is:inline>
      try {
        const stored = localStorage.getItem("openshelf-theme");
        if (stored === "light" || stored === "dark") document.documentElement.dataset.theme = stored;
      } catch {}
    </script>
  </head>
  <body>
    <a class="skip" href="#main">{locale === "en" ? "Skip to content" : "Saltar al contenido"}</a>

    <header class="bar">
      <a class="brand" href={home}>
        <Hex class="brand-hex" />
        OpenShelf
      </a>
      <nav aria-label={locale === "en" ? "Main" : "Principal"}>
        <a href={`${home}#catalog`}>{t("nav.home")}</a>
        <a href={`${home}#listed`}>{t("listed.title")}</a>
        <a href={aboutHref}>{t("nav.about")}</a>
        <span class="lang" role="group" aria-label={t("nav.language")}>
          <a
            href={locale === "en" ? Astro.url.pathname : switchHref}
            aria-current={locale === "en" ? "true" : "false"}
            hreflang="en"
            lang="en"
            title={t("locale.switch.en")}>EN</a
          >
          <a
            href={locale === "es" ? Astro.url.pathname : switchHref}
            aria-current={locale === "es" ? "true" : "false"}
            hreflang="es"
            lang="es"
            title={t("locale.switch.es")}>ES</a
          >
        </span>
        <button
          class="theme"
          type="button"
          data-theme-toggle
          data-label-light={t("theme.toLight")}
          data-label-dark={t("theme.toDark")}
          aria-label={t("theme.toDark")}
        >
          <Hex class="theme-hex" />
        </button>
        <a class="btn small" href={submitUrl} rel="noopener">{t("nav.submit")}</a>
      </nav>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="foot">
      <div class="mark" aria-hidden="true">
        <Hex class="foot-hex" />
        <span>OpenShelf</span>
      </div>
      <div class="foot-cols">
        <ul>
          <li><a href={`${home}#catalog`}>{t("footer.catalog")}</a></li>
          <li><a href={submitUrl} rel="noopener">{t("footer.submit")}</a></li>
          <li><a href={repoUrl("")} rel="noopener">{t("footer.source")}</a></li>
        </ul>
        <ul>
          <li><a href={aboutHref}>{t("footer.about")}</a></li>
          <li>
            <a href={href(localePath(locale, "privacy/"))}>
              {t("footer.privacy")} <span class="draft">{t("legal.badge")}</span>
            </a>
          </li>
          <li>
            <a href={href(localePath(locale, "terms/"))}>
              {t("footer.terms")} <span class="draft">{t("legal.badge")}</span>
            </a>
          </li>
          <li><a href={repoUrl("/blob/main/DISCLAIMER.md")} rel="noopener">{t("footer.disclaimer")}</a></li>
        </ul>
        <p class="fine">
          {t("footer.notAffiliated")} {t("footer.licenses")} {t("footer.draft")}
        </p>
      </div>
    </footer>

    <script is:inline>
      const toggle = document.querySelector("[data-theme-toggle]");
      const isDark = () =>
        document.documentElement.dataset.theme === "dark" ||
        (!document.documentElement.dataset.theme &&
          window.matchMedia("(prefers-color-scheme: dark)").matches);
      const paint = () => {
        if (!toggle) return;
        toggle.setAttribute("aria-label", isDark() ? toggle.dataset.labelLight : toggle.dataset.labelDark);
      };
      paint();
      toggle?.addEventListener("click", () => {
        const next = isDark() ? "light" : "dark";
        document.documentElement.dataset.theme = next;
        try {
          localStorage.setItem("openshelf-theme", next);
        } catch {}
        paint();
      });
    </script>
  </body>
</html>
